# Copy to .env, edit, then load with:  set -a; source .env; set +a
LOKI_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# Colon-separated folders LOKI may read/write
LOKI_ALLOWED_DIRS=~/Documents:~/Desktop:~/Downloads
LOKI_VOICE=Daniel
LOKI_WHISPER_MODEL=base.en
LOKI_MAX_STEPS=8
# Whisper device: cpu, or mps for the Apple GPU (experimental, often faster)
LOKI_WHISPER_DEVICE=cpu
