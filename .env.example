# Copy to .env and edit. LOKI loads it automatically.
# qwen2.5:3b suits 8 GB Macs; use qwen2.5:7b with 16 GB+
LOKI_MODEL=qwen2.5:3b
# Unload the model from RAM this long after the last reply
LOKI_KEEP_ALIVE=2m
OLLAMA_HOST=http://localhost:11434
# Colon-separated folders LOKI may read/write
LOKI_ALLOWED_DIRS=~/Documents:~/Desktop:~/Downloads
# Browser for open_url ("" = system default)
LOKI_BROWSER="Google Chrome"
LOKI_VOICE=Daniel
LOKI_WHISPER_MODEL=base.en
LOKI_MAX_STEPS=8
# Whisper device: cpu, or mps for the Apple GPU (experimental, often faster)
LOKI_WHISPER_DEVICE=cpu
